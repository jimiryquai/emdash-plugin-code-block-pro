---
import { highlightCode } from "../utils/highlighter.js";

interface Props {
  node: {
    _type: "code";
    code: string;
    language?: string;
    filename?: string;
  };
}

const { node } = Astro.props;
const { code, language, filename } = node;
const lang = language || "text";

const highlightedHtml = await highlightCode(code, lang, "github-dark");
---

<div class="code-block-pro">
  {filename && (
    <div class="code-block-pro__header">
      <span class="code-block-pro__filename">{filename}</span>
    </div>
  )}
  <div class="code-block-pro__body">
    <button
      class="code-block-pro__copy"
      aria-label="Copy code to clipboard"
      title="Copy code"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="code-block-pro__copy-icon">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
      </svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="code-block-pro__check-icon" style="display:none">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
    </button>
    <Fragment set:html={highlightedHtml} />
  </div>
</div>

<style>
  .code-block-pro {
    position: relative;
    margin: 1.5em 0;
    border-radius: 8px;
    border: 1px solid #2d333b;
    background-color: #0d1117;
    overflow: hidden;
    font-size: 0.875em;
    line-height: 1.6;
  }

  .code-block-pro__header {
    display: flex;
    align-items: center;
    padding: 0.5em 1em;
    background-color: #161b22;
    border-bottom: 1px solid #2d333b;
    font-size: 0.85em;
    color: #8b949e;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,
      "Liberation Mono", monospace;
  }

  .code-block-pro__filename {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .code-block-pro__body {
    position: relative;
    overflow-x: auto;
  }

  /* Ensure Shiki output uses proper sizing */
  .code-block-pro__body :global(pre) {
    margin: 0;
    padding: 1em;
    background: transparent !important;
    border: none;
    border-radius: 0;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,
      "Liberation Mono", monospace;
    font-size: inherit;
    line-height: inherit;
    overflow-x: visible;
  }

  .code-block-pro__body :global(pre > code) {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    display: block;
  }

  .code-block-pro__copy {
    position: absolute;
    top: 0.5em;
    right: 0.5em;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2em;
    height: 2em;
    padding: 0;
    border: 1px solid #2d333b;
    border-radius: 6px;
    background-color: #161b22;
    color: #8b949e;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, background-color 0.15s ease, color 0.15s ease;
    z-index: 1;
  }

  .code-block-pro__body:hover .code-block-pro__copy,
  .code-block-pro__copy:focus-visible {
    opacity: 1;
  }

  .code-block-pro__copy:hover {
    background-color: #21262d;
    color: #c9d1d9;
  }

  .code-block-pro__copy:active {
    background-color: #30363d;
  }

  /* When header is present, position copy button within header */
  .code-block-pro:has(.code-block-pro__header) .code-block-pro__copy {
    top: 0.35em;
  }
</style>

<script define:vars={{}}>
  // Copy-to-clipboard — inline, no external deps
  document.querySelectorAll(".code-block-pro__copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const body = btn.closest(".code-block-pro__body");
      if (!body) return;

      const codeEl = body.querySelector("code");
      if (!codeEl) return;

      const text = codeEl.textContent || "";

      try {
        await navigator.clipboard.writeText(text);

        // Show check icon briefly
        const copyIcon = btn.querySelector(".code-block-pro__copy-icon");
        const checkIcon = btn.querySelector(".code-block-pro__check-icon");
        if (copyIcon && checkIcon) {
          copyIcon.style.display = "none";
          checkIcon.style.display = "block";
          setTimeout(() => {
            copyIcon.style.display = "block";
            checkIcon.style.display = "none";
          }, 2000);
        }
      } catch {
        // Clipboard API not available — silent fail
      }
    });
  });
</script>

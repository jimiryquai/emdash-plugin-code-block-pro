    {
      "id": "claim_767aa27e110b4dccbbf2df1ee4ef9255",
      "statement": "CodeBlockPro.astro normalizes input before highlighting: it destructures the Portable Text node with defaults (code empty string, language text, theme DEFAULT_THEME, copyButton true), parses the lineHighlights spec, strips one trailing newline from code to avoid an empty last Shiki line, and substitutes a single space for empty code so Shiki still emits a well-formed pre/code skeleton.",
      "evidence": [
        {
          "resource": "repo://src/astro/CodeBlockPro.astro#L29-L47",

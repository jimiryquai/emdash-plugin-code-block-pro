    {
      "id": "claim_3bc470acb3db4640b14e84fa163b517e",
      "statement": "getHighlighter caches a single Promise<Highlighter> in a module-level variable, created with github-dark as the baseline theme, all LANGUAGE_VALUES preloaded, and the JavaScript regex engine; caching the promise means concurrent first renders share one initialization.",
